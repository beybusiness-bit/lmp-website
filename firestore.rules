rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 프로젝트 설정 ─────────────────────────────────────────
    match /cms_projects/{projectId} {
      allow read, write: if true;
      match /stage_content/{stageId} {
        allow read, write: if true;
      }
    }

    // ── 사용자 데이터 (컬렉션명이 동적: cms_users_{projectId}) ──
    match /{userCol}/{userId} {
      allow read, write: if userCol.matches('cms_users_.*');
    }

    // ── 폼 ────────────────────────────────────────────────────
    match /cms_form_configs/{formId} {
      allow read, write: if true;
      match /responses/{responseId} {
        allow read, write: if true;
      }
    }
    match /cms_form_responses/{formId} {
      allow read, write: if true;
      match /responses/{responseId} {
        allow read, write: if true;
      }
    }

    // ── 결제 ─────────────────────────────────────────────────
    match /cms_payment_configs/{configId} {
      allow read, write: if true;
    }
    match /cms_payment_records/{paymentKey} {
      allow read, write: if true;
    }

    // ── 게임/꾸미기 도구 설정 ──────────────────────────────────
    match /game_configs/{docId} {
      allow read, write: if true;
      match /{subCol}/{subDocId} {
        allow read, write: if true;
      }
    }

    // ── 꾸미기(부스) 갤러리 ───────────────────────────────────
    match /cms_booth_gallery/{configId} {
      allow read, write: if true;
      match /images/{imageId} {
        allow read, write: if true;
      }
    }

    // ── 일정 잡기 ─────────────────────────────────────────────
    match /cms_schedule_configs/{configId} {
      allow read, write: if true;
    }
    match /cms_schedule_bookings/{scheduleId} {
      allow read, write: if true;
      match /bookings/{bookingId} {
        allow read, write: if true;
      }
    }

    // ── 문구 생성기 ───────────────────────────────────────────
    match /cms_copy_gen_configs/{configId} {
      allow read, write: if true;
    }
    match /cms_copy_gen_results/{docId} {
      allow read, write: if true;
    }
    match /cms_copy_gen_usages/{docId} {
      allow read, write: if true;
    }

    // ── 유튜브 재생목록 ───────────────────────────────────────
    match /cms_youtube_submissions/{playlistId} {
      allow read, write: if true;
      match /songs/{songId} {
        allow read, write: if true;
      }
    }
    match /cms_youtube_playlists/{docId} {
      allow read, write: if true;
    }

    // ── 방명록 ───────────────────────────────────────────────
    match /cms_guestbook_configs/{configId} {
      allow read, write: if true;
    }
    match /cms_guestbook_entries/{configId} {
      allow read, write: if true;
      match /entries/{entryId} {
        allow read, write: if true;
      }
    }

    // ── admin 전역 설정 (PAT·결제키·사이트 정보 포함) ──────────
    match /cms_admin_settings/{docId} {
      allow read, write: if true;
    }

    // ── 기본값: 위에 명시되지 않은 경로는 모두 차단 ────────────
    // (알 수 없는 컬렉션에 외부에서 임의 접근하는 것을 방지)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
